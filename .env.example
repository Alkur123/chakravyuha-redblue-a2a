# Aegis (the governance API this demo calls; the author's pre-existing product)
AEGIS_BASE_URL=http://localhost:8000
AEGIS_API_KEY=
AEGIS_ADMIN_KEY=          # only for the audit-vault verify at the end

# BAND (run_demo.py --band). One remote agent per role, created at app.band.ai.
BAND_CHAT_ID=
BAND_KEY_BLUE=
BAND_KEY_RED=
BAND_PRINCIPAL_ID=        # your BAND user id: messages from it are the principal channel

# Lyzr (optional; skipped and logged when unset)
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_USER_ID=
LYZR_RAI_URL=

# Target: leave empty to run the sandbox target in-process
TARGET_URL=
TARGET_HARDENED=0
WARROOM_BAND=0
